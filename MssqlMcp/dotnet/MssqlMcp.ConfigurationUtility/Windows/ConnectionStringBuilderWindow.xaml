<Window x:Class="Mssql.McpServer.ConfigurationUtility.Windows.ConnectionStringBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Mssql.McpServer.ConfigurationUtility.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:ConnectionStringBuilderWindowViewModel}"
        Title="{Binding WindowTitle}" SizeToContent="Height" Width="640" MinWidth="500" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Images/ConnectionStringBuilder.ico"
        FocusManager.FocusedElement="{Binding ElementName=txtServer}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="10,10,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="_Server:" Target="{Binding ElementName=txtServer}" VerticalAlignment="Center"></Label>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtServer" Text="{Binding Builder.Server, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5" Padding="2,2,2,2"></TextBox>

        <Label Grid.Row="1" Grid.Column="0" Content="_Database:" Target="{Binding ElementName=txtDatabase}" VerticalAlignment="Center"></Label>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDatabase" Text="{Binding Builder.Database, UpdateSourceTrigger=PropertyChanged}" Margin="5,5,5,5" Padding="2,2,2,2"></TextBox>

        <Label Grid.Row="2" Grid.Column="0" Content="Authentication:" VerticalAlignment="Top" Margin="0,5,0,0"></Label>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,10,5,5">
            <RadioButton x:Name="rbWindowsAuthentication" GroupName="Authentication" Content="_Windows authentication (integrated security)" IsChecked="{Binding Builder.IsWindowsAuthentication}" Margin="0,0,0,5"></RadioButton>
            <RadioButton x:Name="rbSqlServerAuthentication" GroupName="Authentication" Content="SQL Server _authentication" IsChecked="{Binding Builder.IsSqlServerAuthentication}" Margin="0,0,0,5"></RadioButton>
            <RadioButton x:Name="rbOtherAuthentication" GroupName="Authentication" IsChecked="{Binding Builder.IsOtherAuthentication}" Visibility="{Binding Builder.HasOtherAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,5">
                <TextBlock>
                    <Run Text="Keep existing:"/>
                    <Run Text="{Binding Builder.OtherAuthenticationMethod, Mode=OneWay}"/>
                </TextBlock>
            </RadioButton>
        </StackPanel>

        <Label Grid.Row="3" Grid.Column="0" Content="_User name:" Target="{Binding ElementName=txtUserName}" VerticalAlignment="Center"></Label>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtUserName" Text="{Binding Builder.UserName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Builder.IsCredentialsEnabled}" Margin="5,5,5,5" Padding="2,2,2,2"></TextBox>

        <Label Grid.Row="4" Grid.Column="0" Content="_Password:" Target="{Binding ElementName=txtPassword}" VerticalAlignment="Center"></Label>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtPassword" Text="{Binding Builder.Password, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Builder.IsCredentialsEnabled}" Margin="5,5,5,5" Padding="2,2,2,2"></TextBox>

        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="chkTrustServerCertificate" Content="_Trust server certificate" IsChecked="{Binding Builder.TrustServerCertificate}" Margin="5,5,5,5"></CheckBox>

        <Label Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Content="Connection string:" Target="{Binding ElementName=txtConnectionString}" Margin="0,10,0,0"></Label>
        <TextBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" x:Name="txtConnectionString" Text="{Binding Builder.ConnectionString, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="60" Margin="5,0,5,5" Padding="2,2,2,2" Background="{x:Static SystemColors.ControlBrush}"></TextBox>

        <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnTestConnection" Content="Test _connection" MinWidth="80" Padding="5,5,5,5" Margin="5,0,5,0" Click="BtnTestConnection_Click"></Button>
            <Button Grid.Column="2" x:Name="btnOk" Content="OK" IsDefault="True" MinWidth="80" Padding="5,5,5,5" Margin="5,0,0,0" Click="BtnOk_Click"></Button>
            <Button Grid.Column="3" x:Name="btnCancel" Content="Cancel" IsCancel="True" MinWidth="80" Padding="5,5,5,5" Margin="5,0,5,0"></Button>
        </Grid>
    </Grid>
</Window>
