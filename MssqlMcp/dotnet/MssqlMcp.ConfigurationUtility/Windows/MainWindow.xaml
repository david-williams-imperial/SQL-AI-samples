<Window x:Class="Mssql.McpServer.ConfigurationUtility.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Mssql.McpServer.ConfigurationUtility.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainWindowViewModel}"
        Title="MSSQL MCP Server Configuration" Height="600" MinHeight="400" Width="1200" MinWidth="800" WindowStartupLocation="CenterScreen"
        Icon="/Images/MssqlMcpConfiguration.ico">
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Configuration database:" Target="{Binding ElementName=txtConfigurationDatabasePath}" VerticalAlignment="Center"></Label>
            <TextBox Grid.Column="1" x:Name="txtConfigurationDatabasePath" Text="{Binding ConfigurationDatabasePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" Margin="5,5,5,5"></TextBox>
            <Button Grid.Column="2" x:Name="btnChangeConfigurationDatabase" Content="_Change..." Padding="5,5,5,5" Margin="5,5,5,5" Click="BtnChangeConfigurationDatabase_Click"></Button>
            <Button Grid.Column="3" x:Name="btnRefresh" Content="_Refresh" Padding="5,5,5,5" Margin="5,5,5,5" Click="BtnRefresh_Click"></Button>
        </Grid>

        <DataGrid Grid.Row="1" x:Name="dgDatabases" Margin="5,5,5,5" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="MistyRose"/>
                            <Setter Property="ToolTip" Value="{Binding Error}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="ConnectionStringCellStyle" TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="Margin" Value="2,2,2,2"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto" />
                <DataGridTextColumn Header="Database key" Binding="{Binding DatabaseKey}" Width="Auto" MinWidth="150" />
                <DataGridTextColumn Header="Environment" Binding="{Binding EnvironmentName}" Width="Auto" MinWidth="100" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="Auto" MinWidth="150" MaxWidth="300">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Read-only connection string" Binding="{Binding ReadOnlyConnectionStringDisplay}" Width="*" ElementStyle="{StaticResource ConnectionStringCellStyle}" />
                <DataGridTextColumn Header="Write connection string" Binding="{Binding WriteConnectionStringDisplay}" Width="*" ElementStyle="{StaticResource ConnectionStringCellStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnDelete" Content="_Delete database" IsEnabled="{Binding IsItemSelected}" Padding="5,5,5,5" Margin="5,5,5,5" Click="BtnDelete_Click"></Button>
            <Button Grid.Column="1" x:Name="btnEdit" Content="_Edit database" IsEnabled="{Binding IsItemSelected}" Padding="5,5,5,5" Margin="5,5,5,5" Click="BtnEdit_Click"></Button>
            <Button Grid.Column="2" x:Name="btnTestConnection" Content="_Test connection" IsEnabled="{Binding CanTestSelectedItem}" Padding="5,5,5,5" Margin="5,5,5,5" Click="BtnTestConnection_Click"></Button>
            <Button Grid.Column="4" x:Name="btnAdd" Content="_Add database" Padding="5,5,5,5" Margin="5,5,5,5" Click="BtnAdd_Click"></Button>
            <Button Grid.Column="5" x:Name="btnClose" Content="Close" IsCancel="True" Padding="5,5,5,5" Margin="5,5,5,5" Click="BtnClose_Click"></Button>
        </Grid>
    </Grid>
</Window>
