<Window x:Class="Mssql.McpServer.ConfigurationUtility.Windows.DatabaseAddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Mssql.McpServer.ConfigurationUtility.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:DatabaseAddEditWindowViewModel}"
        Title="{Binding WindowTitle}" Height="520" MinHeight="460" Width="800" MinWidth="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Images/DatabaseEdit.ico"
        FocusManager.FocusedElement="{Binding ElementName=txtDatabaseKey}">
    <Grid Margin="10,10,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="180"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="_Database key:" Target="{Binding ElementName=txtDatabaseKey}" FontSize="14"></Label>
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="txtDatabaseKey" Text="{Binding Database.DatabaseKey, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="2,2,2,2"></TextBox>
            <Label Grid.Row="0" Grid.Column="1" Content="E_nvironment:" Target="{Binding ElementName=cboEnvironmentName}" FontSize="14" Margin="10,0,0,0"></Label>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboEnvironmentName" IsEditable="True" ItemsSource="{Binding EnvironmentSuggestions}" Text="{Binding Database.EnvironmentName, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="10,0,0,0" VerticalContentAlignment="Center"></ComboBox>
            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="chkIsActive" Content="Acti_ve" IsChecked="{Binding Database.IsActive}" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Margin="10,0,0,0" ToolTip="Inactive databases are hidden from the MCP server"></CheckBox>
            <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Des_cription:" Target="{Binding ElementName=txtDescription}" FontSize="14" Margin="0,10,0,0"></Label>
            <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" x:Name="txtDescription" Text="{Binding Database.Description, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="2,2,2,2"></TextBox>
        </Grid>

        <Label Grid.Row="2" Grid.Column="0" Content="_Read-only connection string:" Target="{Binding ElementName=txtReadOnlyConnectionString}" FontSize="14" Margin="0,10,0,0" VerticalAlignment="Bottom"></Label>
        <Button Grid.Row="2" Grid.Column="1" x:Name="btnBuildReadOnlyConnectionString" Content="_Build..." MinWidth="80" Padding="5,2,5,2" Margin="0,10,0,3" FontSize="14" Click="BtnBuildReadOnlyConnectionString_Click"></Button>
        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="txtReadOnlyConnectionString" Text="{Binding Database.ReadOnlyConnectionString, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="2,2,2,2"></TextBox>

        <Label Grid.Row="4" Grid.Column="0" Content="_Write connection string (blank for read-only):" Target="{Binding ElementName=txtWriteConnectionString}" FontSize="14" Margin="0,10,0,0" VerticalAlignment="Bottom"></Label>
        <Button Grid.Row="4" Grid.Column="1" x:Name="btnBuildWriteConnectionString" Content="B_uild..." MinWidth="80" Padding="5,2,5,2" Margin="0,10,0,3" FontSize="14" Click="BtnBuildWriteConnectionString_Click"></Button>
        <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" x:Name="txtWriteConnectionString" Text="{Binding Database.WriteConnectionString, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="2,2,2,2"></TextBox>

        <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnTestConnections" Content="_Test connections" MinWidth="80" Padding="5,5,5,5" FontSize="14" Click="BtnTestConnections_Click"></Button>
            <Button Grid.Column="2" x:Name="btnSave" Content="_Save" IsDefault="True" MinWidth="80" Padding="5,5,5,5" Margin="5,0,0,0" FontSize="14" Click="BtnSave_Click"></Button>
            <Button Grid.Column="3" x:Name="btnCancel" Content="Cancel" IsCancel="True" MinWidth="80" Padding="5,5,5,5" Margin="5,0,0,0" FontSize="14"></Button>
        </Grid>
    </Grid>
</Window>
